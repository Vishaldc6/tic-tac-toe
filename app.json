{
  "expo": {
    "name": "Shunya Chokadi: Tic-Tac-Toe",
    "slug": "tic-tac-toe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#121214"
      },
      "package": "com.vishaldc.tictactoe"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#121214"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "androidStatusBar": {
      "translucent": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f184f55e-0084-4c1d-9323-ab25ef2c4c89"
      }
    },
    "owner": "vishaldc"
  }
}
